{
  "name": "xyven-launcher",
  "version": "1.0.16",
  "description": "Xyven Launcher",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron .vite/build/main.js",
    "dev": "vite --config vite.renderer.config.ts",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "make": "electron-builder --win nsis",
    "lint": "eslint electron/*.ts src/renderer.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "png-to-ico": "^2.1.0",
    "vite": "^5.0.0"
  }
}
